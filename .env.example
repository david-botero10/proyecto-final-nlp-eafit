# Copia este archivo a `.env` y rellena solo lo que uses.
# Nunca subas `.env` al repo. Los valores de abajo son defaults locales de
# desarrollo (credenciales sintéticas, no secretos).

# Conexión a PostgreSQL. El default coincide con docker-compose.yml.
DATABASE_URL=postgresql://relevo:relevo@localhost:5432/relevo

# Puerto publicado del servicio `db` (compose usa ${PGPORT:-5432}).
PGPORT=5432

# --- Llegan en S3 (prototipo con Grok y observabilidad). No rellenar aún. ---

# Clave de xAI para Grok 4.6 vía @ai-sdk/xai.
# XAI_API_KEY=

# OpenTelemetry → Arize Phoenix (host, puerto y collector).
# PHOENIX_HOST=
# PHOENIX_PORT=
# PHOENIX_COLLECTOR_ENDPOINT=
# Copia este archivo a `.env` y rellena solo lo que uses.
# Nunca subas `.env` al repo. Los valores de abajo son defaults locales de
# desarrollo (credenciales sintéticas, no secretos).

# Conexión a PostgreSQL. El default coincide con docker-compose.yml.
DATABASE_URL=postgresql://relevo:relevo@localhost:5432/relevo

# Puerto publicado del servicio `db` (compose usa ${PGPORT:-5432}).
PGPORT=5432

# Clave de xAI para el asistente Grok vía @ai-sdk/xai.
# Sin valor, el chat sigue en el stream simulado y pide configurarla.
# Nunca pongas una clave real en el repo, en logs ni en tests.
XAI_API_KEY=

# Modelo de chat. Si se omite, el backend usa grok-4.7.
RELEVO_MODELO=grok-4.7

# Servicio local de embeddings bge-m3 y re-ranking (npm run embed:dev).
EMBED_SERVICE_URL=http://localhost:8631

# Auditor A2A (ola D2). El asistente llama a AUDITOR_URL.
# `npm run auditor:dev` escucha en AUDITOR_PORT (default 8641).
AUDITOR_URL=http://127.0.0.1:8641
AUDITOR_PORT=8641
# Milisegundos que el cliente espera el veredicto. Sin respuesta: null («sin auditar»).
AUDITOR_TIMEOUT_MS=8000

# Extractor afinado (ola E2). `npm run extractor:dev` escucha en EXTRACTOR_PORT.
# POST {EXTRACTOR_URL}/extraer con {orden, fecha_referencia}.
# Vacío: la extracción usa solo Grok. Si el servicio falla, también cae a Grok.
EXTRACTOR_URL=http://127.0.0.1:8642
EXTRACTOR_PORT=8642

# OpenTelemetry → Arize Phoenix (docker compose, servicio phoenix, puerto 6006).
# Sin estas variables el backend usa los defaults y, si Phoenix no responde,
# sigue atendiendo sin escribir errores en cada request.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
OTEL_SERVICE_NAME=relevo
# ---------------------------------------------------------------------------
# Despliegue en la nube (Vercel + Neon + Modal). Ver docs/DESPLIEGUE.md.
# Todas vacías = modo local, sin cambios. Los valores reales van solo en
# las variables de entorno de Vercel, nunca en el repo.
# ---------------------------------------------------------------------------

# Código de acceso a toda la app (SECRETO). Vacío: sin compuerta.
ACCESS_CODE=

# Secreto compartido entre el asistente y el auditor A2A (SECRETO). El cliente
# lo envía en la cabecera x-auditor-token y las rutas /a2a y
# /.well-known/agent.json lo exigen. Vacío: sin verificación (local).
AUDITOR_TOKEN=

# URL pública de la app para la Agent Card. Vacío: se deduce de la petición.
# En la nube, AUDITOR_URL apunta a la propia app (https://<app>.vercel.app).
AUDITOR_PUBLIC_URL=

# Conexión del auditor con un usuario de solo lectura (SECRETO). Vacío: usa
# DATABASE_URL. Con Neon es lo que aísla al auditor, porque SET ROLE de
# sesión no es fiable detrás del pooler en modo transacción.
AUDITOR_DATABASE_URL=

# Modo serverless del cliente de BD: 1 fuerza prepare=false, ssl y pool
# pequeño aunque el host no sea de Neon. Con un host *.neon.tech se activa solo.
DB_SERVERLESS=
# Tope de conexiones por instancia en modo serverless (default 1).
DB_POOL_MAX=
